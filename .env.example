# Choose your LLM provider: "groq" (free tier, default) or "anthropic" (paid).
RAG_LLM_PROVIDER=groq

# --- Groq (free) ---
# Get a free key at https://console.groq.com/keys (no credit card required
# for the free tier).
GROQ_API_KEY=your-groq-key-here

# --- Anthropic (paid, only needed if RAG_LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=your-anthropic-key-here

# --- Optional overrides (defaults shown) ---
# RAG_LLM_MODEL=llama-3.3-70b-versatile   # groq default; use claude-sonnet-4-6 for anthropic
# RAG_LLM_MAX_TOKENS=1024
# RAG_LLM_TIMEOUT_SECONDS=30
# RAG_LLM_MAX_RETRIES=1

# RAG_EMBEDDING_BACKEND=tfidf        # "tfidf" (offline, default) or "st" (sentence-transformers)
# RAG_ST_MODEL=all-MiniLM-L6-v2

# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=120

# RAG_TOP_K=4
# RAG_PERSIST_DIR=./chroma_db
# RAG_COLLECTION=agentic_rag_docs

# RAG_RELEVANCE_THRESHOLD=0.5
# RAG_MAX_REWRITES=2
# RAG_MAX_GEN_RETRIES=2
# RAG_ENABLE_WEB_FALLBACK=true
# RAG_ENABLE_CONTEXT_COVERAGE=true

# RAG_VERBOSE=true
